---
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import { Status } from "@components/Telegram";
import Link from "@components/Link.astro";
import ShinyText from "@components/ShinyText";
import SplitText from "@components/SplitText";
import { HOME, SITE, SOCIALS } from "@consts";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
	<Container>
		<aside data-pagefind-ignore>
			<SplitText
				text="hey, i'm Matin!"
				className="font-semibold text-black dark:text-white"
				delay={50}
				animationFrom={{
					opacity: 0,
					transform: "translate3d(0, 50px, 0)",
				}}
				animationTo={{ opacity: 1, transform: "translate3d(0, 0, 0)" }}
				threshold={0.2}
				client:load
			/>
			<Status client:load />
			<div class="space-y-16">
				<section>
					<article class="space-y-4">
						<span class="animate">
							<p>
								I'm a Computer Engineering student passionate about software development and Linux system administration. I build clean, scalable applications using a versatile stack that includes Python, C, C++, Rust, JavaScript, TypeScript, NestJS, NextJS, and Tailwind CSS, with Postgres as my preferred database.
							</p>
							<p>
								My homelab, running on Linux with Proxmox, Docker, Kubernetes, and Ansible, is my sandbox for exploring system automation, DevOps practices, and infrastructure design. You can find my projects and contributions on GitHub.
							</p>
						</span>

						<span class="animate">
							<p>
								I also run a growing YouTube channel where I share hands-on tutorials on coding, Linux system administration, and software projects, breaking down complex topics for practical learning.
							</p>

							<p>
								When I’m not writing code or managing servers, I’m usually gaming or diving into personal projects for the sheer joy of building something new. Let’s connect to create innovative, robust software solutions!
							</p>
						</span>
					</article>
				</section>

				<section class="animate space-y-6">
					<div
						class="flex flex-wrap items-center justify-between gap-y-2"
					>
						<h2 class="font-semibold text-black dark:text-white">
							latest posts
						</h2>
						<Link href="/blog">
							<ShinyText
								text="see all posts"
								className="underline"
								disabled={false}
								speed={2}
								client:load
							/>
						</Link>
					</div>
					<ul class="not-prose flex flex-col gap-4">
						{
							blog.map((post) => (
								<li>
									<ArrowCard entry={post} />
								</li>
							))
						}
					</ul>
				</section>

				<section class="animate space-y-4">
					<h2 class="font-semibold text-black dark:text-white">
						let's connect
					</h2>
					<article>
						<p>
							if you want to get in touch with me about something
							or just to say hi, reach out on social media or send
							me an email.
						</p>
					</article>
					<ul class="not-prose flex flex-wrap gap-2">
						{
							SOCIALS.map((SOCIAL) => (
								<li class="flex gap-x-2 text-nowrap">
									<Link
										href={SOCIAL.HREF}
										external
										aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
									>
										{SOCIAL.NAME}
									</Link>
									{"/"}
								</li>
							))
						}
						<li class="line-clamp-1">
							<Link
								href={`mailto:${SITE.EMAIL}`}
								aria-label={`Email ${SITE.TITLE}`}
							>
								{SITE.EMAIL}
							</Link>
						</li>
					</ul>
				</section>
			</div>
		</aside>
	</Container>
</Layout>
